#!/usr/bin/env bash
#
# aiab: Antigravity In A Basket
# Host launcher and manager for isolated Antigravity YOLO container
# Supports both Docker and Podman container runtimes.
#

set -e

# Configuration (can be overridden via environment variables)
AGY_IMAGE="${AGY_IMAGE:-agy-yolo:latest}"
BASKET_TAG="${BASKET_TAG:-agy-basket:latest}"
AGY_DATA_VOLUME="${AGY_DATA_VOLUME:-agy-data}"
AGY_CONFIG_VOLUME="${AGY_CONFIG_VOLUME:-agy-config}"
CONTAINER_RUNTIME="${CONTAINER_RUNTIME:-}"
AIAB_KATA="${AIAB_KATA:-0}"
AIAB_HYPERVISOR="${AIAB_HYPERVISOR:-}"
KATA_RUNTIME="${KATA_RUNTIME:-kata-runtime}"
KVM_DEVICE="${KVM_DEVICE:-/dev/kvm}"

# Determine repository root directory if available (for rebuild/update)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${SCRIPT_DIR}/../Dockerfile" ]; then
    REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
else
    REPO_DIR=""
fi

show_help() {
    cat <<EOF
aiab (Antigravity In A Basket) - Containerized Google Antigravity Runner (YOLO Mode)

Usage:
  aiab [DIRECTORY] [OPTIONS...]
  aiab [DIRECTORY] bash
  aiab [COMMAND]

Commands:
  update        Pull latest base image and rebuild container with newest agy CLI
  rebuild       Force clean rebuild of the container image without cache
  status        Display container image, volume sizes, and agy CLI version
  check-kata    Verify host KVM support and Kata Containers runtime status
  clean         Prune stopped containers and dangling images
  backup-auth   Backup persistent auth tokens and conversations to a tar archive
  reset-auth    Reset persistent authentication (clears stored tokens and databases)
  uninstall     Remove images, volumes, and installed wrappers from ~/.local/bin

Arguments:
  DIRECTORY     Path to project directory (default: current directory '.')
  OPTIONS       Flags forwarded to agy (e.g., --continue, --model, --effort)
  --kata / --hypervisor  Launch container enclosed in a Kata Containers KVM microVM
  bash / sh     Launch an interactive bash shell inside the container instead of agy

Examples:
  aiab                              # Launch agy in current directory
  aiab --kata                       # Launch with hardware KVM microVM isolation
  aiab ~/projects/my-app --kata     # Launch project enclosed in Kata microVM
  aiab check-kata                   # Run hypervisor and KVM diagnostics
  aiab update                       # Update container with the latest agy CLI release
  aiab status                       # Show container image and volume status
  aiab ~/projects/my-app            # Launch agy in specific project directory
  aiab . --continue                 # Resume most recent conversation in current directory
  aiab . bash                       # Open an interactive bash shell in the project container

Configuration:
  CONTAINER_RUNTIME Container engine to use: 'docker' or 'podman' (default: auto-detected)
  AGY_IMAGE         Container image to run (default: agy-yolo:latest)
  AGY_DATA_VOLUME   Container volume for persistent auth & tokens (default: agy-data)
  AGY_CONFIG_VOLUME Container volume for persistent configs (default: agy-config)
  AIAB_KATA         Enable Kata Containers microVM hypervisor isolation by default (1/0)
  KATA_RUNTIME      Kata runtime name or binary path (default: kata-runtime)
EOF
}

# Auto-detect container runtime if not explicitly specified
detect_runtime() {
    if [ -n "$CONTAINER_RUNTIME" ]; then
        if ! command -v "$CONTAINER_RUNTIME" >/dev/null 2>&1; then
            echo "❌ Error: Configured CONTAINER_RUNTIME='$CONTAINER_RUNTIME' not found in PATH." >&2
            exit 1
        fi
        return 0
    fi

    if command -v podman >/dev/null 2>&1; then
        CONTAINER_RUNTIME="podman"
    elif command -v docker >/dev/null 2>&1; then
        CONTAINER_RUNTIME="docker"
    else
        echo "❌ Error: Neither Podman nor Docker is installed or found in PATH." >&2
        echo "Please install Docker (e.g. sudo apt install docker.io) or Podman (e.g. sudo apt install podman)." >&2
        exit 1
    fi
}

check_runtime() {
    detect_runtime

    if [ "$CONTAINER_RUNTIME" = "docker" ]; then
        if ! docker info >/dev/null 2>&1; then
            echo "❌ Error: Cannot connect to Docker daemon. Is Docker running, and is your user in the 'docker' group?" >&2
            exit 1
        fi
    elif [ "$CONTAINER_RUNTIME" = "podman" ]; then
        if ! podman info >/dev/null 2>&1; then
            echo "❌ Error: Podman is installed but 'podman info' failed." >&2
            exit 1
        fi
    fi
}

find_repo_dir() {
    if [ -n "$REPO_DIR" ] && [ -f "$REPO_DIR/Dockerfile" ]; then
        echo "$REPO_DIR"
        return 0
    fi
    local real_script
    real_script="$(realpath "${BASH_SOURCE[0]}")"
    local candidate
    candidate="$(cd "$(dirname "$real_script")/.." 2>/dev/null && pwd)"
    if [ -f "$candidate/Dockerfile" ]; then
        echo "$candidate"
        return 0
    fi
    echo ""
}

# Subcommand: update
cmd_update() {
    check_runtime
    local repo
    repo="$(find_repo_dir)"
    if [ -z "$repo" ]; then
        echo "❌ Error: Could not locate agyInABasket repository containing Dockerfile." >&2
        exit 1
    fi

    local host_uid host_gid
    host_uid="$(id -u)"
    host_gid="$(id -g)"

    echo "🔄 Pulling latest base image and updating agy CLI via ${CONTAINER_RUNTIME}..."
    "$CONTAINER_RUNTIME" pull ubuntu:24.04
    "$CONTAINER_RUNTIME" build \
        --no-cache \
        --build-arg USER_UID="${host_uid}" \
        --build-arg USER_GID="${host_gid}" \
        -t "${AGY_IMAGE}" \
        -t "${BASKET_TAG}" \
        "$repo"

    echo "✓ Update complete! aiab is now running the latest container image."
}

# Subcommand: rebuild
cmd_rebuild() {
    check_runtime
    local repo
    repo="$(find_repo_dir)"
    if [ -z "$repo" ]; then
        echo "❌ Error: Could not locate agyInABasket repository containing Dockerfile." >&2
        exit 1
    fi

    local host_uid host_gid
    host_uid="$(id -u)"
    host_gid="$(id -g)"

    echo "🔨 Forcing clean rebuild without cache via ${CONTAINER_RUNTIME}..."
    "$CONTAINER_RUNTIME" build \
        --no-cache \
        --build-arg USER_UID="${host_uid}" \
        --build-arg USER_GID="${host_gid}" \
        -t "${AGY_IMAGE}" \
        -t "${BASKET_TAG}" \
        "$repo"

    echo "✓ Rebuild complete!"
}

# Subcommand: status
cmd_status() {
    check_runtime
    echo "=== agyInABasket (aiab) Status [Runtime: ${CONTAINER_RUNTIME}] ==="
    echo ""
    echo "--- Container Image ---"
    "$CONTAINER_RUNTIME" images "${AGY_IMAGE}" --format "table {{.Repository}}\t{{.Tag}}\t{{.ID}}\t{{.CreatedSince}}\t{{.Size}}"
    echo ""
    echo "--- Persistent Volumes ---"
    "$CONTAINER_RUNTIME" volume ls --filter "name=agy-"
    echo ""
    echo "--- Hypervisor Isolation (Kata Containers) ---"
    if [ -e "${KVM_DEVICE}" ]; then
        if [ -r "${KVM_DEVICE}" ] && [ -w "${KVM_DEVICE}" ]; then
            echo "Hardware KVM: Available & Accessible (${KVM_DEVICE})"
        else
            echo "Hardware KVM: Present (${KVM_DEVICE}), permissions needed: sudo usermod -aG kvm \$USER"
        fi
    else
        echo "Hardware KVM: Not detected (enable virtualization in BIOS/UEFI)"
    fi
    if command -v kata-runtime >/dev/null 2>&1; then
        echo "Kata Runtime: Installed ($(command -v kata-runtime))"
    elif [ -x "/usr/bin/kata-runtime" ]; then
        echo "Kata Runtime: Installed (/usr/bin/kata-runtime)"
    else
        echo "Kata Runtime: Not installed (run 'aiab check-kata' for install details)"
    fi
    echo ""
    echo "--- agy CLI Version (inside container) ---"
    "$CONTAINER_RUNTIME" run --rm "${AGY_IMAGE}" agy changelog 2>/dev/null | head -n 10 || echo "Version check unavailable."
}

# Subcommand: check-kata
cmd_check_kata() {
    echo "=========================================================="
    echo "     Kata Containers & KVM Hypervisor Diagnostic         "
    echo "=========================================================="
    echo ""
    local all_good=true

    # 1. Check KVM device
    echo "1. Checking hardware virtualization (${KVM_DEVICE})..."
    if [ -e "${KVM_DEVICE}" ]; then
        if [ -r "${KVM_DEVICE}" ] && [ -w "${KVM_DEVICE}" ]; then
            echo "   ✓ ${KVM_DEVICE} exists and is accessible by current user."
        else
            echo "   ⚠️ ${KVM_DEVICE} exists, but current user lacks read/write permissions."
            echo "      Fix by running: sudo usermod -aG kvm \$USER && newgrp kvm"
            all_good=false
        fi
    else
        echo "   ❌ ${KVM_DEVICE} not found."
        echo "      Ensure CPU virtualization (Intel VT-x or AMD-V) is enabled in your BIOS/UEFI."
        all_good=false
    fi
    echo ""

    # 2. Check Kata runtime binary
    echo "2. Checking Kata Containers installation..."
    local kata_bin=""
    if command -v kata-runtime >/dev/null 2>&1; then
        kata_bin="$(command -v kata-runtime)"
    elif [ -x "/usr/bin/kata-runtime" ]; then
        kata_bin="/usr/bin/kata-runtime"
    fi

    if [ -n "$kata_bin" ]; then
        echo "   ✓ kata-runtime found at: $kata_bin"
        if "$kata_bin" kata-check >/dev/null 2>&1; then
            echo "   ✓ 'kata-runtime kata-check' passed successfully."
        else
            echo "   ℹ️ Note: 'kata-runtime kata-check' reported host warnings or non-zero exit."
        fi
    else
        echo "   ❌ kata-runtime is not installed on the host."
        echo "      To install Kata Containers on Ubuntu/Debian:"
        echo "        sudo apt-get update && sudo apt-get install -y kata-containers"
        echo "      Or visit: https://github.com/kata-containers/kata-containers"
        all_good=false
    fi
    echo ""

    # 3. Check Container runtime integration
    echo "3. Checking container runtime configuration..."
    local runtime_found=""
    if [ -n "$CONTAINER_RUNTIME" ] && command -v "$CONTAINER_RUNTIME" >/dev/null 2>&1; then
        runtime_found="$CONTAINER_RUNTIME"
    elif command -v podman >/dev/null 2>&1; then
        runtime_found="podman"
    elif command -v docker >/dev/null 2>&1; then
        runtime_found="docker"
    fi

    if [ -z "$runtime_found" ]; then
        echo "   ❌ Neither Podman nor Docker was found in PATH."
        all_good=false
    else
        echo "   Detected container engine: ${runtime_found}"
        if [ "$runtime_found" = "docker" ]; then
            if docker info 2>/dev/null | grep -qi "kata"; then
                echo "   ✓ Kata runtime is registered in Docker daemon."
            else
                echo "   ℹ️ Docker is active. To register Kata runtime in Docker (/etc/docker/daemon.json):"
                echo '      { "runtimes": { "kata-runtime": { "path": "/usr/bin/kata-runtime" } } }'
                echo "      Then restart docker: sudo systemctl restart docker"
            fi
        elif [ "$runtime_found" = "podman" ]; then
            echo "   ✓ Podman detected. Podman supports Kata directly via:"
            echo "     --runtime=/usr/bin/kata-runtime or --runtime=kata-runtime"
        fi
    fi
    echo ""

    if [ "$all_good" = true ]; then
        echo "🎉 System is ready! You can launch with hypervisor isolation using:"
        echo "   aiab --kata"
        echo "   or: AIAB_KATA=1 aiab"
        echo "=========================================================="
        return 0
    else
        echo "⚠️  Please address the items above before running aiab with --kata."
        echo "=========================================================="
        return 1
    fi
}

# Subcommand: clean
cmd_clean() {
    check_runtime
    echo "🧹 Pruning stopped containers and dangling images via ${CONTAINER_RUNTIME}..."
    "$CONTAINER_RUNTIME" ps -a --filter "name=agy-" --filter "status=exited" -q | xargs -r "$CONTAINER_RUNTIME" rm 2>/dev/null || true
    "$CONTAINER_RUNTIME" image prune -f
    echo "✓ Cleanup finished!"
}

# Subcommand: backup-auth
cmd_backup_auth() {
    check_runtime
    local backup_file="${HOME}/agy-auth-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
    echo "💾 Backing up ${AGY_DATA_VOLUME} to ${backup_file}..."
    "$CONTAINER_RUNTIME" run --rm \
        -v "${AGY_DATA_VOLUME}:/data:ro" \
        -v "${HOME}:/backup" \
        busybox tar -czf "/backup/$(basename "${backup_file}")" -C /data .
    echo "✓ Backup created at: ${backup_file}"
}

# Subcommand: reset-auth
cmd_reset_auth() {
    check_runtime
    read -rp "⚠️ Are you sure you want to reset persistent auth data? You will need to log into Antigravity again. (y/N) " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo "🗑️ Resetting ${AGY_DATA_VOLUME} and ${AGY_CONFIG_VOLUME}..."
        "$CONTAINER_RUNTIME" volume rm -f "${AGY_DATA_VOLUME}" "${AGY_CONFIG_VOLUME}" 2>/dev/null || true
        "$CONTAINER_RUNTIME" volume create "${AGY_DATA_VOLUME}" >/dev/null
        "$CONTAINER_RUNTIME" volume create "${AGY_CONFIG_VOLUME}" >/dev/null
        echo "✓ Auth reset. Fresh volumes created."
    else
        echo "Operation cancelled."
    fi
}

# Subcommand: uninstall
cmd_uninstall() {
    check_runtime
    read -rp "⚠️ This will delete the agy-yolo container images and wrappers from ~/.local/bin. Proceed? (y/N) " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -f "${HOME}/.local/bin/aiab"
        "$CONTAINER_RUNTIME" rmi -f "${AGY_IMAGE}" "${BASKET_TAG}" 2>/dev/null || true
        echo "✓ Binary and images removed. Persistent volumes ('${AGY_DATA_VOLUME}') were kept intact."
    else
        echo "Uninstall cancelled."
    fi
}

# Check for help flag
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    show_help
    exit 0
fi

# Route maintenance subcommands
case "${1:-}" in
    update)       cmd_update; exit 0 ;;
    rebuild)      cmd_rebuild; exit 0 ;;
    status)       cmd_status; exit 0 ;;
    check-kata)   cmd_check_kata; exit 0 ;;
    clean)        cmd_clean; exit 0 ;;
    backup-auth)  cmd_backup_auth; exit 0 ;;
    reset-auth)   cmd_reset_auth; exit 0 ;;
    uninstall)    cmd_uninstall; exit 0 ;;
esac

check_runtime

# Initialize Kata configuration from environment
USE_KATA="${AIAB_KATA:-0}"
if [ "${AIAB_HYPERVISOR:-}" = "kata" ]; then
    USE_KATA=1
fi

# Parse arguments: extract target directory, --kata / --hypervisor flags, and forwarded options
RAW_ARGS=("$@")
FILTERED_ARGS=()
TARGET_DIR="."
TARGET_DIR_SET=false

for arg in "${RAW_ARGS[@]}"; do
    if [ "$arg" = "--kata" ] || [ "$arg" = "--hypervisor" ]; then
        USE_KATA=1
    elif [ "$TARGET_DIR_SET" = false ] && [ -d "$arg" ]; then
        TARGET_DIR="$arg"
        TARGET_DIR_SET=true
    elif [ "$TARGET_DIR_SET" = false ] && [[ "$arg" != -* && "$arg" != "bash" && "$arg" != "sh" ]]; then
        if [ ! -e "$arg" ]; then
            echo "❌ Error: Directory does not exist: $arg" >&2
            exit 1
        fi
        TARGET_DIR="$arg"
        TARGET_DIR_SET=true
    else
        FILTERED_ARGS+=("$arg")
    fi
done

TARGET_DIR="$(realpath "$TARGET_DIR")"

if [ ! -d "$TARGET_DIR" ]; then
    echo "❌ Error: Target path is not a directory: $TARGET_DIR" >&2
    exit 1
fi

# Check if image exists; if agy-yolo doesn't exist, try agy-basket:latest
if ! "$CONTAINER_RUNTIME" image inspect "$AGY_IMAGE" >/dev/null 2>&1; then
    if "$CONTAINER_RUNTIME" image inspect "${BASKET_TAG}" >/dev/null 2>&1; then
        AGY_IMAGE="${BASKET_TAG}"
    else
        echo "❌ Error: Container image '$AGY_IMAGE' not found in ${CONTAINER_RUNTIME}." >&2
        echo "Please build the image first by running:" >&2
        echo "  ./scripts/install.sh" >&2
        exit 1
    fi
fi

# Ensure persistent volumes exist
"$CONTAINER_RUNTIME" volume create "$AGY_DATA_VOLUME" >/dev/null 2>&1 || true
"$CONTAINER_RUNTIME" volume create "$AGY_CONFIG_VOLUME" >/dev/null 2>&1 || true

# Setup terminal flags (-it if connected to interactive terminal)
RUN_FLAGS=()
if [ -t 0 ] && [ -t 1 ]; then
    RUN_FLAGS+=("-it")
fi

# Podman-specific runtime flags: rootless UID mapping and SELinux volume relabeling
VOLUME_SUFFIX=""
if [ "$CONTAINER_RUNTIME" = "podman" ]; then
    RUN_FLAGS+=("--userns=keep-id")
    VOLUME_SUFFIX=":Z"
fi

# Hypervisor (Kata Containers) validation and configuration
if [ "$USE_KATA" = "1" ]; then
    if [ ! -e "${KVM_DEVICE}" ]; then
        echo "❌ Error: ${KVM_DEVICE} not found." >&2
        echo "Hardware virtualization is required for Kata Containers." >&2
        echo "Please enable Intel VT-x or AMD-V in your BIOS/UEFI settings, or run without --kata." >&2
        exit 1
    fi
    if [ ! -r "${KVM_DEVICE}" ] || [ ! -w "${KVM_DEVICE}" ]; then
        echo "❌ Error: Permission denied accessing ${KVM_DEVICE}." >&2
        echo "Please add your user to the kvm group: sudo usermod -aG kvm \$USER" >&2
        exit 1
    fi

    local_kata_target="${KATA_RUNTIME}"
    if [ "$CONTAINER_RUNTIME" = "podman" ] && [ -x "/usr/bin/kata-runtime" ] && [ "${KATA_RUNTIME}" = "kata-runtime" ]; then
        local_kata_target="/usr/bin/kata-runtime"
    fi
    RUN_FLAGS+=("--runtime=${local_kata_target}")
fi

# Generate session container name based on directory basename and PID
SESSION_NAME="agy-$(basename "$TARGET_DIR" | tr -c 'a-zA-Z0-9_' '_')-$$"

echo "🧺 Launching Antigravity via ${CONTAINER_RUNTIME} in isolated basket: $SESSION_NAME"
if [ "$USE_KATA" = "1" ]; then
    echo "🛡️  Hypervisor Isolation: Kata Containers microVM active (KVM hardware virtualization)"
fi
echo "📂 Workspace: $TARGET_DIR"
echo "💾 Persisting auth data in volume: $AGY_DATA_VOLUME"

exec "$CONTAINER_RUNTIME" run "${RUN_FLAGS[@]}" --rm \
    --name "$SESSION_NAME" \
    -e TERM="${TERM:-xterm-256color}" \
    -v "$TARGET_DIR:/home/minty/workspace${VOLUME_SUFFIX}" \
    -v "$AGY_DATA_VOLUME:/home/minty/.gemini" \
    -v "$AGY_CONFIG_VOLUME:/home/minty/.config" \
    "$AGY_IMAGE" "${FILTERED_ARGS[@]}"
